apiVersion: v1
kind: Pod
metadata: {name: mem-writer, namespace: noetl}
spec:
  terminationGracePeriodSeconds: 1
  restartPolicy: Never
  containers:
  - name: w
    image: localhost/noetl-worker-rust:__TAG__
    imagePullPolicy: Never
    command: ["/bin/sh","-c"]
    args: ["export NOETL_COMMAND_BUS_SHARD=0 NOETL_EVENT_BUS_SHARD=0; exec ./noetl-worker"]
    resources: {limits: {cpu: "__CPU__", memory: 6Gi}, requests: {cpu: "200m", memory: 512Mi}}
    env:
    - {name: NOETL_EHDB_TIER_SERVICE_BIND,  value: "0.0.0.0:9110"}
    - {name: NOETL_EHDB_TIER_SERVICE_DIR,   value: "/data/eventbus/ehdb-tier"}
    - {name: NOETL_EHDB_TIER_SEAL_MAX_BYTES,value: "__SEAL__"}
    - {name: NOETL_EHDB_TIER_MAX_INFLIGHT,  value: "4"}
    - {name: NOETL_EHDB_TIER_SERVICE_TIMEOUT_MS, value: "2000"}
    - {name: NOETL_EHDB_SEAL_MAX_AGE_MS,    value: "5000"}
    - {name: NOETL_EHDB_REFERENCE_RUNTIME_CACHE, value: "true"}
    - {name: WORKER_POOL_NAME,              value: "cmdbus-writer"}
    - {name: WORKER_MAX_CONCURRENT,         value: "1"}
    - {name: WORKER_METRICS_BIND,           value: "0.0.0.0:9090"}
    - {name: RUST_LOG,                      value: "info,noetl_worker=info"}
    - {name: NOETL_SERVER_URL,              value: "http://127.0.0.1:1"}
    - {name: NOETL_INTERNAL_API_TOKEN,      value: "gate-local-only"}
    - {name: NOETL_COMMAND_BUS,             value: "ehdb"}
    - {name: NOETL_COMMAND_BUS_HOST,        value: "true"}
    - {name: NOETL_COMMAND_SHARD_COUNT,     value: "1"}
    - {name: NOETL_COMMAND_BUS_WRITER_DIR,  value: "/data/cmdbus"}
    - {name: NOETL_COMMAND_BUS_INGEST_BIND, value: "0.0.0.0:9100"}
    - {name: NOETL_COMMAND_BUS_CLAIM_BIND,  value: "0.0.0.0:9101"}
    - {name: NOETL_COMMAND_BUS_METRICS_BIND,value: "0.0.0.0:9102"}
    - {name: NOETL_COMMAND_BUS_CLAIM_ADDR,  value: "127.0.0.1:9101"}
    - {name: NOETL_FEED_FILTER_SUBJECT,     value: "noetl.commands.cmdbus.>"}
    - {name: NOETL_EVENT_BUS_HOST,          value: "true"}
    - {name: NOETL_EVENT_SHARD_COUNT,       value: "1"}
    - {name: NOETL_EVENT_BUS_WRITER_DIR,    value: "/data/eventbus"}
    - {name: NOETL_EVENT_BUS_KV_DIR,        value: "/data/eventkv"}
    - {name: NOETL_EVENT_BUS_INGEST_BIND,   value: "0.0.0.0:9103"}
    - {name: NOETL_EVENT_BUS_CLAIM_BIND,    value: "0.0.0.0:9104"}
    - {name: NOETL_EVENT_BUS_SSE_BIND,      value: "0.0.0.0:9105"}
    - {name: NOETL_EVENT_BUS_METRICS_BIND,  value: "0.0.0.0:9106"}
    - {name: NOETL_EVENT_BUS_KV_BIND,       value: "0.0.0.0:9107"}
    - {name: NOETL_EVENT_BUS_WAL_BIND,      value: "0.0.0.0:9108"}
    volumeMounts: [{name: d, mountPath: /data}]
  volumes:
  - name: d
    hostPath: {path: /gate-tier, type: DirectoryOrCreate}
