diff --git a/.dockerignore b/.dockerignore
index 52fe10e..f9edb05 100644
--- a/.dockerignore
+++ b/.dockerignore
@@ -1,8 +1,10 @@
-target
-# Nested Cargo target dirs (e.g. plugins/reference-materializer/target) — the
-# top-level `target` glob only matches at the context root, so without this a
-# locally-built plug-in ships its whole target dir in the build context.
-**/target
+# NOTE: patterns here are NOT root-anchored unless they start with `/`.
+# A bare `target` — and `**/target` just as much — matches ANY path segment
+# named target, including `vendor/cc/src/target/`, which makes `cargo chef cook`
+# fail with "failed to calculate checksum of /app/vendor/cc/src/target/apple.rs".
+# Anchor the top-level one and name the nested plug-in target dirs explicitly.
+/target
+/plugins/reference-materializer/target
 .git
 .github
 .DS_Store
